# Express Server Port
PORT=3000

# Gemini API Key (used in Stage 3 for the Agent Loop)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: GitHub Personal Access Token (for higher API rate limits: 5000/hr vs 60/hr)
GITHUB_TOKEN=

# Demo Bearer Token for protected MCP operations (Knowledge Base and GitHub tools)
# NOTE: This is a pre-shared educational bearer token, NOT a full OAuth 2.1 system.
MCP_DEMO_TOKEN=mcp-secret-token-123

# Comma-separated scopes granted to the demo token
MCP_ALLOWED_SCOPES=github:read,knowledge:read

# Agent Loop Configuration (used in Stage 3)
MAX_AGENT_ITERATIONS=5
